page {
  background: #0f0c29;
}

.settings-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

/* Form */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 14rpx;
}

.form-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  color: #ffffff;
}

.form-textarea {
  min-height: 150rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  color: #ffffff;
  width: 100%;
  box-sizing: border-box;
}

/* Avatar */
.avatar-upload {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #3a3a4e;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.upload-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* Cover */
.cover-upload {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.12);
}

.cover-placeholder {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.25);
}

/* Divider */
.form-divider {
  padding: 16rpx 0 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-top: 8rpx;
}

.divider-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* Submit */
.submit-section {
  margin-top: 40rpx;
}

.btn-save {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  border-radius: 16rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}
