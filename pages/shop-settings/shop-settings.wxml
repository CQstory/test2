<view class="settings-page">
  <!-- 头像 -->
  <view class="form-group">
    <text class="form-label">店铺头像</text>
    <view class="avatar-upload">
      <image class="avatar-preview" src="{{form.avatar}}" mode="aspectFill" />
      <text class="upload-hint">点击更换头像</text>
    </view>
  </view>

  <!-- 封面 -->
  <view class="form-group">
    <text class="form-label">店铺封面</text>
    <view class="cover-upload">
      <text class="cover-placeholder">+ 上传封面图</text>
    </view>
  </view>

  <!-- 名称 -->
  <view class="form-group">
    <text class="form-label">店铺名称</text>
    <input
      class="form-input"
      value="{{form.name}}"
      data-field="name"
      bindinput="onInput"
      placeholder="请输入店铺名称"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <!-- 简介 -->
  <view class="form-group">
    <text class="form-label">店铺简介</text>
    <textarea
      class="form-textarea"
      value="{{form.description}}"
      data-field="description"
      bindinput="onInput"
      placeholder="请描述你的店铺特色..."
      placeholder-style="color: rgba(255,255,255,0.2)"
      maxlength="-1"
      auto-height
    />
  </view>

  <!-- 联系方式 -->
  <view class="form-divider">
    <text class="divider-text">联系方式</text>
  </view>

  <view class="form-group">
    <text class="form-label">微信号</text>
    <input
      class="form-input"
      value="{{form.wechat}}"
      data-field="wechat"
      bindinput="onInput"
      placeholder="客户可见的微信号"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <view class="form-group">
    <text class="form-label">手机号</text>
    <input
      class="form-input"
      value="{{form.phone}}"
      data-field="phone"
      bindinput="onInput"
      type="number"
      placeholder="客户可见的手机号"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <view class="form-group">
    <text class="form-label">邮箱</text>
    <input
      class="form-input"
      value="{{form.email}}"
      data-field="email"
      bindinput="onInput"
      placeholder="客户可见的邮箱"
      placeholder-style="color: rgba(255,255,255,0.2)"
    />
  </view>

  <!-- 保存按钮 -->
  <view class="submit-section">
    <button class="btn-save" bindtap="onSave">保存设置</button>
  </view>
</view>
