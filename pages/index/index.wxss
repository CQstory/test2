page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #0f0c29, #1a1a2e, #16213e);
}

.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  filter: drop-shadow(0 4px 12px rgba(78, 205, 196, 0.4));
}

.title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  text-align: center;
}

.subtitle {
  color: rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
  text-align: center;
}

.features {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 80rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.feature-icon {
  font-size: 30rpx;
}

.feature-text {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
}

.btn-enter {
  width: 520rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  border: none;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 30rpx rgba(78, 205, 196, 0.35);
}

.btn-enter:active {
  opacity: 0.85;
  transform: scale(0.97);
}
