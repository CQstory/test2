<view class="page">
  <top-bar title="登录" showBack="{{true}}" />
  <view class="page-content">
    <view class="form-card">
      <text class="form-title">欢迎回来</text>
      <view class="input-group">
        <text class="input-label">用户名</text>
        <input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="input-group">
        <text class="input-label">密码</text>
        <input class="form-input" placeholder="请输入密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <view class="error-tip" wx:if="{{errorMsg}}">
        <text>{{errorMsg}}</text>
      </view>
      <button class="btn-submit" bindtap="onLogin">登录</button>
      <view class="form-links">
        <text bindtap="onGoRegister">注册账号</text>
        <text bindtap="onGoReset">忘记密码</text>
      </view>
    </view>
  </view>
</view>
