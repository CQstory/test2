<view class="page">
  <top-bar title="{{merchantName || '商家模型'}}" showBack="{{true}}" />
  <view class="page-content">
    <view class="model-grid">
      <view wx:for="{{models}}" wx:key="id" class="grid-item">
        <model-card model="{{item}}" bind:tap="onCardTap" />
      </view>
    </view>
    <view class="empty" wx:if="{{models.length === 0}}">
      <text>暂无模型</text>
    </view>
  </view>
</view>
