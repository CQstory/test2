page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #1a1a2e;
}

.viewer-container {
  position: relative;
  width: 100%;
  height: 100%;
}

.webgl-canvas {
  width: 100%;
  height: 100%;
}

.hint-overlay {
  position: absolute;
  bottom: 180rpx;
  left: 48rpx;
  right: 48rpx;
  z-index: 8;
  pointer-events: none;
  display: flex;
  justify-content: center;
}

.hint-text {
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  backdrop-filter: blur(10px);
}

.toolbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  pointer-events: none;
}

.toolbar-top,
.toolbar-bottom {
  pointer-events: auto;
}

.toolbar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 24rpx;
  background: linear-gradient(180deg, rgba(26, 26, 46, 0.95) 0%, rgba(26, 26, 46, 0) 100%);
}

.model-name {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  font-weight: 500;
}

.btn-icon {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toolbar-bottom {
  position: absolute;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.btn-action {
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  line-height: 1.4;
}

.btn-action:active {
  background: rgba(255, 255, 255, 0.25);
}

.url-panel {
  position: absolute;
  bottom: 140rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 10;
  background: rgba(26, 26, 46, 0.95);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20px);
}

.url-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.url-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.url-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.btn-load {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 24rpx;
  background: #4ecdc4;
  color: #1a1a2e;
  border: none;
  border-radius: 12rpx;
  font-weight: 600;
}

.url-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
}
