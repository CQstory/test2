page {
  background: #0f0c29;
}

.detail-page {
  padding-bottom: 40rpx;
}

/* Thumb */
.thumb-section {
  position: relative;
  width: 100%;
}

.detail-thumb {
  width: 100%;
  background: #2a2a3e;
}

.thumb-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 28rpx 20rpx;
  background: linear-gradient(transparent, rgba(15, 12, 41, 0.9));
}

.overlay-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(78, 205, 196, 0.2);
  border: 1rpx solid rgba(78, 205, 196, 0.3);
  border-radius: 6rpx;
}

/* Info */
.info-section {
  padding: 32rpx 28rpx;
}

.model-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 16rpx;
}

.model-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.model-specs {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.spec-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.spec-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.spec-value {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

/* View 3D Button */
.btn-view-3d {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  border-radius: 16rpx;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.btn-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
}

/* Merchant */
.merchant-section {
  padding: 0 28rpx 32rpx;
}

.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 16rpx;
}

.section-action {
  font-size: 24rpx;
  color: #4ecdc4;
  margin-bottom: 16rpx;
}

.merchant-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 16rpx;
}

.merchant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #3a3a4e;
  flex-shrink: 0;
}

.merchant-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.merchant-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
}

.merchant-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.merchant-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-left: 12rpx;
}

.btn-contact {
  width: 100%;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* Related */
.related-section {
  padding: 0 28rpx;
}

.related-section .section-title {
  margin-bottom: 16rpx;
}

.related-scroll {
  width: 100%;
  white-space: nowrap;
}

.related-list {
  display: flex;
  gap: 20rpx;
}

.related-item {
  display: inline-block;
  width: 280rpx;
}
