page {
  background: #0f0c29;
}

.profile-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.top-bar {
  padding: 100rpx 32rpx 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

/* User card */
.user-card {
  margin: 0 32rpx 32rpx;
  padding: 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.user-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* Menu */
.menu-section {
  padding: 0 24rpx;
}

.menu-section .menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 12rpx;
}

.menu-section .menu-item:active {
  background: rgba(255, 255, 255, 0.1);
}

.menu-section .menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-section .menu-text {
  flex: 1;
}

.menu-section .menu-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  display: block;
  margin-bottom: 4rpx;
}

.menu-section .menu-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.menu-section .menu-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* Footer */
.footer {
  padding: 48rpx 0 32rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.2);
}
