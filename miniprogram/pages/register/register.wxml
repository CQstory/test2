<view class="page">
  <top-bar title="注册" showBack="{{true}}" />
  <view class="page-content">
    <view class="form-card">
      <text class="form-title">创建账号</text>
      <view class="input-group">
        <text class="input-label">用户名</text>
        <input class="form-input" placeholder="请输入用户名（至少3位）" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="input-group">
        <text class="input-label">密码</text>
        <input class="form-input" placeholder="请输入密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <view class="input-group">
        <text class="input-label">确认密码</text>
        <input class="form-input" placeholder="请再次输入密码" password="{{true}}" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
      </view>
      <view class="error-tip" wx:if="{{errorMsg}}">
        <text>{{errorMsg}}</text>
      </view>
      <button class="btn-submit" bindtap="onRegister">注册</button>
      <view class="form-links">
        <text bindtap="onGoLogin">已有账号？登录</text>
      </view>
    </view>
  </view>
</view>
