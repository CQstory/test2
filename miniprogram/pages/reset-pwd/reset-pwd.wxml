<view class="page">
  <top-bar title="找回密码" showBack="{{true}}" />
  <view class="page-content">
    <view class="form-card">
      <text class="form-title">找回密码</text>
      <view class="input-group">
        <text class="input-label">用户名</text>
        <input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="msg-tip" wx:if="{{msg}}">
        <text>{{msg}}</text>
      </view>
      <button class="btn-submit" bindtap="onReset">发送重置链接</button>
    </view>
  </view>
</view>
