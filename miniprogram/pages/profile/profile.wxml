<view class="page">
  <top-bar title="我的" />
  <view class="page-content">
    <view class="user-card">
      <image class="user-avatar" src="https://api.dicebear.com/8.x/shapes/svg?seed=user" mode="aspectFill" />
      <text class="user-name">{{userInfo ? userInfo.username : '未登录'}}</text>
      <view class="login-btns" wx:if="{{!userInfo}}">
        <button class="btn-login" bindtap="onGoLogin">登录</button>
        <button class="btn-register" bindtap="onGoRegister">注册</button>
      </view>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="onGoFavorites">
        <text class="menu-icon">❤️</text>
        <text class="menu-label">我的收藏</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoPricing">
        <text class="menu-icon">💎</text>
        <text class="menu-label">套餐定价</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onGoShopSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">店铺设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="bottom-spacer"></view>
  </view>
  <tab-bar active="profile" />
</view>
