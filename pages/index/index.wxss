page {
  background: #0f0c29;
}

.home-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* Hero */
.hero {
  position: relative;
  padding: 160rpx 40rpx 60rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: -60rpx;
  left: -100rpx;
  right: -100rpx;
  bottom: 0;
  background: radial-gradient(ellipse at 50% 0%, rgba(78, 205, 196, 0.12) 0%, transparent 70%),
              radial-gradient(ellipse at 80% 50%, rgba(68, 136, 255, 0.08) 0%, transparent 60%);
}

.hero-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  line-height: 1.6;
  max-width: 560rpx;
}

.hero-stats {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 48rpx;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4ecdc4;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* Section */
.section {
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 24rpx;
  display: block;
}

.section-more {
  font-size: 24rpx;
  color: #4ecdc4;
  margin-bottom: 24rpx;
}

/* Features */
.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.feature-card {
  padding: 28rpx 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.feature-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  text-align: center;
  line-height: 1.4;
}

/* Categories */
.categories-scroll {
  display: flex;
  gap: 20rpx;
}

.category-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.category-chip:active {
  background: rgba(78, 205, 196, 0.15);
  border-color: rgba(78, 205, 196, 0.3);
}

.chip-icon {
  font-size: 28rpx;
}

.chip-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* Featured scroll */
.featured-scroll {
  width: 100%;
  white-space: nowrap;
}

.featured-list {
  display: flex;
  gap: 20rpx;
  padding-bottom: 4rpx;
}

.featured-item {
  display: inline-block;
  width: 320rpx;
}

/* CTA Banner */
.cta-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.15), rgba(68, 160, 141, 0.1));
  border-radius: 20rpx;
  border: 1rpx solid rgba(78, 205, 196, 0.2);
}

.cta-text {
  flex: 1;
}

.cta-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.cta-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.4;
  display: block;
}

.cta-arrow {
  font-size: 48rpx;
  color: #4ecdc4;
  margin-left: 16rpx;
}

.bottom-spacer {
  height: 20rpx;
}
