.card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  transition: transform 0.15s;
}

.card:active {
  transform: scale(0.97);
}

.card-thumb-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #2a2a3e;
}

.card-thumb {
  width: 100%;
  height: 100%;
}

.card-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
}

.tag-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card-body {
  padding: 16rpx 20rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 12rpx;
  min-height: 30rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-merchant {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.merchant-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #3a3a4e;
}

.merchant-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-category {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(78, 205, 196, 0.15);
  border: 1rpx solid rgba(78, 205, 196, 0.25);
}

.category-text {
  font-size: 18rpx;
  color: #4ecdc4;
}
