page {
  background: #0f0c29;
}

.store-page {
  padding-bottom: 40rpx;
}

/* Cover */
.store-cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  background: #2a2a3e;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, #0f0c29);
}

/* Info */
.store-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx 24rpx;
  margin-top: -60rpx;
  position: relative;
}

.store-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #0f0c29;
  background: #3a3a4e;
  margin-bottom: 16rpx;
}

.store-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.store-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 16rpx;
  max-width: 600rpx;
}

.store-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.store-stats .stat {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.store-stats .stat-divider {
  color: rgba(255, 255, 255, 0.15);
}

/* Contact */
.contact-row {
  padding: 0 32rpx 32rpx;
}

.btn-contact {
  width: 100%;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #4ecdc4, #44a08d);
  border-radius: 16rpx;
  border: none;
  font-weight: 500;
}

/* Models */
.models-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 20rpx;
}

.models-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.models-grid > model-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 30vh;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.3);
}
