page {
  background: #0f0c29;
}

.mm-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.add-btn {
  padding: 12rpx 28rpx;
  background: #4ecdc4;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #1a1a2e;
}

/* List */
.model-list {
  padding: 0 24rpx;
}

.model-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.model-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #2a2a3e;
  flex-shrink: 0;
}

.model-info {
  flex: 1;
  margin-left: 20rpx;
}

.model-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.model-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.model-status {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
}

.model-status.published {
  color: #4ecdc4;
  background: rgba(78, 205, 196, 0.12);
}

.model-status.pending {
  color: #f0ad4e;
  background: rgba(240, 173, 78, 0.12);
}

.model-status.offline {
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.06);
}

.model-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-left: 12rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8rpx;
  text-align: center;
}

.action-delete {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.1);
}
